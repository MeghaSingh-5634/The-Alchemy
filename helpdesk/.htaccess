# THE HELPDESK FOLDER · only the chat endpoint and the builder can be
# reached from the web. the index, the facts, the library and any
# config stay private
Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^(api|build)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(api|build)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>
